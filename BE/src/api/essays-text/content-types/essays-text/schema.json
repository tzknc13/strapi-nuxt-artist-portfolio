      "required": true
    },
    "content": {
      "type": "richtext",
      "required": true
    },
    "single_image": {
      "type": "media",
      "allowedTypes": [
        "images",
        "files",
        "videos"
      ],
      "multiple": false,
      "required": false
    },
    "date_written": {
      "type": "date",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "short_text": {
      "type": "text"
    },
    "position_in_view": {
      "type": "integer"
    }
