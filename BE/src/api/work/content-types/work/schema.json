    "categories": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::category.category",
      "mappedBy": "works"
    },
    "images": {
      "type": "media",
      "allowedTypes": [
        "files",
        "images",
        "videos"
      ],
      "multiple": true,
      "required": true
    },
    "slug": {
