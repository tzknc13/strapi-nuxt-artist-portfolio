      "required": true
    },
    "description_1": {
      "type": "richtext"
    },
    "description_2": {
      "type": "richtext"
    },
    "medium": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "coauthor": {
      "type": "string"
    },
    "year": {
      "type": "integer"
    },
    "dimensions": {
      "type": "string"
    },
    "position_in_view": {
      "type": "integer"
    }
