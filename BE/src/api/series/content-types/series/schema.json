{
  "kind": "collectionType",
  "collectionName": "series_list",
  "info": {
    "singularName": "series",
    "pluralName": "series-list",
    "displayName": "Series",
    "name": "series"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "series_name": {
      "type": "string",
      "required": true
    },
    "works": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::work.work",
      "inversedBy": "series"
    },
    "single_image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images",
        "files",
        "videos"
      ]
    },
    "slug": {
      "type": "uid",
      "targetField": "series_name",
      "required": true
    },
    "description": {
      "type": "richtext",
      "default": "// toto je volitelne"
    },
    "year": {
      "type": "biginteger",
      "required": true
    },
    "position_in_view": {
      "type": "integer",
      "required": false,
      "default": 0,
      "unique": false
    },
    "show_description_field": {
      "type": "boolean",
      "default": true
    }
  }
}
